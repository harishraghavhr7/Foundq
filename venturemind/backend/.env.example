# Copy to .env and fill in real values.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/venturemind

# Comma-separated list of origins allowed to call the API (the React dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# LLM Provider selection: "ollama" (local, free) or "gemini" (cloud API)
LLM_PROVIDER=ollama

# Ollama local LLM configuration (when LLM_PROVIDER=ollama)
# Start Ollama locally: ollama run llama3.2 (or mistral, qwen2.5, phi3, etc.)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120.0

# Google Gemini — used when LLM_PROVIDER=gemini (or as fallback in auto mode).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud API — ultra-fast Llama models.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter API — aggregated access to top AI models.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Automatic multi-provider fallback order (handled via LangChain ModelFallbackMiddleware and FallbackLLMClient)
LLM_FALLBACK_ORDER=openrouter,gemini,groq,ollama

# Optional: Real-Time Agent Tool Calling Keys
# Tavily Search: https://tavily.com
TAVILY_API_KEY=
# Serper Search: https://serper.dev
SERPER_API_KEY=

